generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                   String              @id @default(cuid())
  slug                 String              @unique
  name                 String
  tagline              String?
  description          String
  price                Int
  compareAtPrice       Int?
  category             String
  recipient            String
  occasion             String
  tags                 Tag[]
  badge                String?
  images               String              @default("[]")
  sizes                String              @default("")
  colors               String              @default("")
  stock                Int                 @default(40)
  sku                  String              @unique
  barcode              String?
  supplier             String?
  supplierCost         Int                 @default(0)
  supplierConnectionId String?
  supplierConnection   SupplierConnection? @relation(fields: [supplierConnectionId], references: [id], onDelete: SetNull)
  supplierProductId    String?
  supplierSku          String?
  supplierUrl          String?
  supplierCurrency     String              @default("ZAR")
  supplierPrice        Int?
  shipsFrom            String              @default("South Africa")
  leadTimeMin          Int                 @default(2)
  leadTimeMax          Int                 @default(5)
  promoLabel           String?
  promoEndsAt          DateTime?
  status               String              @default("ACTIVE")
  featured             Boolean             @default(false)
  rating               Float               @default(4.8)
  reviewCount          Int                 @default(0)
  reviews              String              @default("[]")
  reviewEntries        Review[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  orderItems           OrderItem[]
  wishlistedBy         WishlistItem[]
  customRequests       CustomRequest[]

  @@index([category])
  @@index([recipient])
  @@index([occasion])
  @@index([status])
  @@index([supplierConnectionId])
}

model Tag {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  kind        String    @default("STYLE")
  description String?
  featured    Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model SupplierConnection {
  id               String   @id @default(cuid())
  name             String
  provider         String   @default("CJ")
  kind             String   @default("CHINA")
  enabled          Boolean  @default(true)
  status           String   @default("UNTESTED")
  credentialsEnc   String?
  apiBaseUrl       String?
  defaultMarkupPct Int      @default(60)
  defaultCurrency  String   @default("USD")
  defaultShipsFrom String   @default("China")
  defaultLeadMin   Int      @default(10)
  defaultLeadMax   Int      @default(18)
  notes            String?
  lastTestedAt     DateTime?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  products         Product[]
  promos           Promo[]
  customRequests   CustomRequest[]
}

model Promo {
  id                   String              @id @default(cuid())
  code                 String              @unique
  label                String
  description          String?
  type                 String              @default("PERCENT")
  value                Int
  minSubtotal          Int                 @default(0)
  scope                String              @default("ALL")
  scopeValue           String?
  supplierConnectionId String?
  supplierConnection   SupplierConnection? @relation(fields: [supplierConnectionId], references: [id], onDelete: SetNull)
  startsAt             DateTime?
  endsAt               DateTime?
  maxUses              Int?
  usedCount            Int                 @default(0)
  active               Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  firstName       String
  lastName        String
  phone           String
  address         String
  city            String
  province        String
  postalCode      String
  giftNote        String?
  notes           String?
  subtotal        Int
  shipping        Int
  discount        Int         @default(0)
  total           Int
  supplierCost    Int         @default(0)
  status          String      @default("PENDING")
  paymentStatus   String      @default("unpaid")
  paymentProvider String?
  paymentRef      String?
  discountCode    String?
  promoLabel      String?
  courier         String?
  trackingNumber  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  productId            String?
  name                 String
  sku                  String?
  price                Int
  quantity             Int
  size                 String?
  image                String
  supplierName         String?
  supplierConnectionId String?
  supplierOrderRef     String?
  fulfilmentStatus     String  @default("PENDING")
  order                Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model User {
  id                  String                @id @default(cuid())
  accountId           String?               @unique
  email               String                @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  defaultAddress      String?
  defaultCity         String?
  defaultProvince     String?
  defaultPostalCode   String?
  marketingEmail      Boolean               @default(true)
  marketingWhatsapp   Boolean               @default(false)
  role                String                @default("CUSTOMER")
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int                   @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  sessions            Session[]
  passkeys            Passkey[]
  reviews             Review[]
  wishlist            WishlistItem[]
  orders              Order[]
  supportConversations SupportConversation[]
  customRequests      CustomRequest[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String    @default("")
  deviceType   String?
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  userId       String?
  name         String
  email        String
  rating       Int
  title        String
  body         String
  status       String   @default("PENDING")
  verified     Boolean  @default(false)
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())
  approvedAt   DateTime?
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([status, createdAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model SupportConversation {
  id            String           @id @default(cuid())
  ref           String           @unique
  userId        String?
  name          String
  email         String
  subject       String
  status        String           @default("OPEN")
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]

  @@index([status, lastMessageAt])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  sender         String
  body           String
  readByAgent    Boolean             @default(false)
  readByCustomer Boolean             @default(false)
  createdAt      DateTime            @default(now())
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model StoreSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CustomRequest {
  id           String              @id @default(cuid())
  ref          String              @unique
  userId       String?
  productId    String?
  connectionId String?
  name         String
  email        String
  phone        String?
  garment      String
  colour       String
  size         String
  quantity     Int                 @default(1)
  printStyle   String
  monogram     String?
  notes        String?
  status       String              @default("NEW")
  quote        Int?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  product      Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  connection   SupplierConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

